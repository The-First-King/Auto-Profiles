<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Theme overlay for the master switch in the green app bar.
         On a colorPrimary background the normal green active color is invisible,
         so this switch uses white when ON; the Dark overlay parent keeps the
         OFF state light enough to read on green. All other switches in the app
         keep the standard green styling from AppTheme. -->
    <style name="MasterSwitchTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="colorControlActivated">@color/white</item>
    </style>

    <!-- Switch Theme -->
    <style name="SwitchTheme" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="colorSwitchThumbNormal">@color/colorPrimary</item>
    </style>

    <!-- Card View Theme -->
    <style name="CardViewTheme">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <!-- Button Theme -->
    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_primary_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
